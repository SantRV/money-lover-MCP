{
  "mcpServers": {
    "money-lover": {
      "command": "npx",
      "args": ["-y", "github:SantRV/money-lover-MCP"],
      "env": {
        "MONEYLOVER_EMAIL": "you@example.com",
        "MONEYLOVER_PASSWORD": "your-password",
        "MONEYLOVER_TIMEZONE": "Australia/Adelaide"
      }
    }
  }
}
